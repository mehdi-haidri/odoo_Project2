<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Course Form View -->
        <record id="view_elearning_course_form" model="ir.ui.view">
            <field name="name">elearning.course.form</field>
            <field name="model">elearning.course</field>
            <field name="arch" type="xml">
                <form string="Course">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="image" widget="image" class="oe_avatar"/>
                                <field name="instructor_id"/>
                                <field name="category_id" required="1"/>
                            </group>
                            <group>
                                <field name="level"/>
                                <field name="price"/>
                                <field name="duration_hours"/>
                                <field name="is_published"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                            <page string="Lessons">
                                <field name="lessons">
                                    <tree>
                                        <field name="name"/>
                                        <field name="sequence"/>
                                        <field name="duration_minutes"/>
                                        <field name="is_published"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Enrollments">
                                <field name="enrollments">
                                    <tree>
                                        <field name="student_id"/>
                                        <field name="status"/>
                                        <field name="progress"/>
                                        <field name="enrollment_date"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Course Tree View -->
        <record id="view_elearning_course_tree" model="ir.ui.view">
            <field name="name">elearning.course.tree</field>
            <field name="model">elearning.course</field>
            <field name="arch" type="xml">
                <tree string="Courses">
                    <field name="name"/>
                    <field name="instructor_id"/>
                    <field name="level"/>
                    <field name="student_count"/>
                    <field name="is_published"/>
                </tree>
            </field>
        </record>

        <!-- Course Kanban View -->
        <record id="view_elearning_course_kanban" model="ir.ui.view">
            <field name="name">elearning.course.kanban</field>
            <field name="model">elearning.course</field>
            <field name="arch" type="xml">
                <kanban class="o_elearning_kanban" create="true">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="is_published"/>
                    <field name="lesson_count"/>
                    <field name="duration_hours"/>
                    <field name="rating"/>
                    <field name="rating_count"/>
                    <field name="enrollment_inprogress_count"/>
                    <field name="enrollment_completed_count"/>
                    <field name="student_count"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click oe_kanban_card oe_kanban_content p-0">
                                <!-- Ribbon -->
                                <div t-if="record.is_published.raw_value" class="ribbon ribbon-top-right">
                                    <span class="bg-success">Published</span>
                                </div>
                                <div t-if="!record.is_published.raw_value" class="ribbon ribbon-top-right">
                                    <span class="bg-danger">Unpublished</span>
                                </div>

                                <div class="o_kanban_content p-3">
                                    <div class="o_kanban_card_header mb-3">
                                        <div class="o_kanban_card_header_title">
                                            <h3 class="o_primary mt-0"><field name="name"/></h3>
                                        </div>
                                    </div>
                                    
                                    <div class="container-fluid p-0">
                                        <div class="row mb-3">
                                            <div class="col-6">
                                                <button class="btn btn-primary btn-sm" name="action_view_course" type="object">
                                                    View Course
                                                </button>
                                            </div>
                                            <div class="col-6">
                                                <div class="row">
                                                    <div class="col-6 text-muted small">Contents</div>
                                                    <div class="col-6 text-right small font-weight-bold"><field name="lesson_count"/></div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-6 text-muted small">Duration</div>
                                                    <div class="col-6 text-right small font-weight-bold">
                                                        <t t-esc="Math.floor(record.duration_hours.raw_value)"/>:<t t-esc="Math.round((record.duration_hours.raw_value % 1) * 60).toString().padStart(2, '0')"/>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-6 text-muted small">Rating</div>
                                                    <div class="col-6 text-right small font-weight-bold"><field name="rating"/> / 5</div>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="row border-top pt-2 mt-2">
                                            <div class="col-4 border-right text-center">
                                                <div class="font-weight-bold"><field name="enrollment_inprogress_count"/></div>
                                                <div class="text-muted small">In Progress</div>
                                            </div>
                                            <div class="col-4 border-right text-center">
                                                <div class="font-weight-bold"><field name="enrollment_completed_count"/></div>
                                                <div class="text-muted small">Completed</div>
                                            </div>
                                            <div class="col-4 text-center">
                                                <div class="font-weight-bold"><field name="student_count"/></div>
                                                <div class="text-muted small">Total</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Course Action -->
        <record id="action_elearning_course" model="ir.actions.act_window">
            <field name="name">Courses</field>
            <field name="res_model">elearning.course</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_elearning" name="E-Learning" sequence="10"/>
        <!-- Submenu items moved to menuitems.xml -->
        <!-- Server Action to Recalculate Progress for Course -->
        <record id="action_course_recalculate_progress" model="ir.actions.server">
            <field name="name">Recalculate Student Progress</field>
            <field name="model_id" ref="model_elearning_course"/>
            <field name="binding_model_id" ref="model_elearning_course"/>
            <field name="state">code</field>
            <field name="code">
for course in records:
    enrollments = env['elearning.enrollment'].search([('course_id', '=', course.id)])
    enrollments._recompute_progress()
            </field>
        </record>
    </data>
</odoo>
