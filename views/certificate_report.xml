<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Report Action -->
        <record id="action_report_elearning_certificate" model="ir.actions.report">
            <field name="name">Certificate</field>
            <field name="model">elearning.certificate</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">odoo_Project2.report_certificate_document</field>
            <field name="report_file">odoo_Project2.report_certificate_document</field>
            <field name="print_report_name">'Certificate - %s' % (object.name)</field>
            <field name="binding_model_id" ref="model_elearning_certificate"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_certificate_landscape"/>
        </record>

        <!-- Report Template -->
        <template id="report_certificate_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.basic_layout">
                        <div class="page" style="font-family: 'Georgia', serif; color: #333; width: 100%; height: 100%;">
                            <div style="border: 15px solid #2c3e50; padding: 10px; height: 185mm; position: relative; background-color: #f9f9f9;">
                                <div style="border: 5px solid #c0392b; padding: 20px; height: 100%; position: relative; text-align: center; background: white;">
                                    
                                    <!-- Watermark/Background Icon -->
                                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); opacity: 0.05; z-index: 0;">
                                        <i class="fa fa-certificate" style="font-size: 400px;"></i>
                                    </div>

                                    <!-- Header -->
                                    <div style="margin-top: 40px; position: relative; z-index: 1;">
                                        <h1 style="font-size: 56px; font-weight: bold; text-transform: uppercase; letter-spacing: 4px; color: #2c3e50; margin-bottom: 10px;">Certificate</h1>
                                        <h3 style="font-size: 24px; color: #7f8c8d; text-transform: uppercase; letter-spacing: 2px;">of Course Completion</h3>
                                    </div>
                                    
                                    <div style="margin-top: 40px; font-size: 20px; font-style: italic; color: #555;">
                                        This is to certify that
                                    </div>
                                    
                                    <!-- Student Name -->
                                    <div style="margin-top: 20px; position: relative; z-index: 1;">
                                        <h2 style="font-size: 48px; font-weight: bold; color: #c0392b; font-family: 'Pinyon Script', cursive, serif; border-bottom: 2px solid #eee; display: inline-block; padding: 0 40px 10px 40px;">
                                            <span t-field="o.student_id.name"/>
                                        </h2>
                                    </div>
                                    
                                    <div style="margin-top: 30px; font-size: 20px; font-style: italic; color: #555;">
                                        has successfully completed the course
                                    </div>
                                    
                                    <!-- Course Name -->
                                    <div style="margin-top: 20px; position: relative; z-index: 1;">
                                        <h2 style="font-size: 36px; font-weight: bold; color: #2c3e50;"><span t-field="o.course_id.name"/></h2>
                                    </div>
                                    
                                    <!-- Details -->
                                    <div style="margin-top: 30px; font-size: 18px; color: #555;">
                                        <p>Course Duration: <span t-field="o.course_id.duration_hours"/> Hours</p>
                                    </div>
                                    
                                    <!-- Signatures and Date -->
                                    <div style="position: absolute; bottom: 80px; width: 100%; display: flex; justify-content: space-between; padding: 0 80px; box-sizing: border-box;">
                                        <div style="text-align: center; width: 250px;">
                                            <div style="border-bottom: 2px solid #2c3e50; margin-bottom: 10px; padding-bottom: 5px; font-size: 18px;">
                                                <span t-field="o.issue_date" t-options='{"widget": "date"}'/>
                                            </div>
                                            <strong style="color: #7f8c8d; text-transform: uppercase; font-size: 14px;">Date Issued</strong>
                                        </div>
                                        
                                        <!-- Seal -->
                                        <div style="text-align: center;">
                                            <img src="/odoo_Project2/static/src/img/seal.png" style="width: 100px; opacity: 0.8;" onerror="this.style.display='none'"/>
                                        </div>

                                        <div style="text-align: center; width: 250px;">
                                            <div style="border-bottom: 2px solid #2c3e50; margin-bottom: 10px; padding-bottom: 5px; font-size: 18px; font-family: 'Pinyon Script', cursive, serif;">
                                                <span t-field="o.course_id.instructor_id.name"/>
                                            </div>
                                            <strong style="color: #7f8c8d; text-transform: uppercase; font-size: 14px;">Instructor Signature</strong>
                                        </div>
                                    </div>
                                    
                                    <!-- Footer / Verification -->
                                    <div style="position: absolute; bottom: 20px; width: 100%; text-align: center; font-size: 12px; color: #95a5a6; font-family: monospace;">
                                        Certificate ID: <span t-field="o.certificate_code"/> | Verify at: <span t-esc="user.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>/elearning/certificate/<span t-field="o.id"/>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
