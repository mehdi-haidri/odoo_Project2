<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="courses_template" name="E-Learning Courses">
        <t t-call="website.layout">
            <div id="elearning_courses" class="elearning-container">
                <div class="container">
                    <div class="row mb-5">
                        <div class="col-lg-6">
                            <h1 class="mb-3">
                                <t t-if="my_courses_mode">My Courses</t>
                                <t t-else="">Online Courses</t>
                            </h1>
                            <p class="lead text-muted">
                                <t t-if="my_courses_mode">Continue learning where you left off</t>
                                <t t-else="">Learn new skills at your own pace with our comprehensive courses</t>
                            </p>
                        </div>
                        <div class="col-lg-6">
                            <form method="get" class="card p-3 bg-light border-0">
                                <div class="input-group mb-2">
                                    <input type="text" name="search" class="form-control" placeholder="Search courses..." t-att-value="search_term"/>
                                    <div class="input-group-append">
                                        <button class="btn btn-primary" type="submit"><i class="fa fa-search"></i></button>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="col">
                                        <input type="number" name="min_price" class="form-control form-control-sm" placeholder="Min Price" t-att-value="min_price"/>
                                    </div>
                                    <div class="col">
                                        <input type="number" name="max_price" class="form-control form-control-sm" placeholder="Max Price" t-att-value="max_price"/>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    
                    <t t-if="courses">
                        <div class="row">
                            <t t-foreach="courses" t-as="course">
                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div class="card elearning-course-card h-100">
                                        <t t-if="course.image">
                                            <img class="card-img-top elearning-course-image" t-attf-src="data:image/png;base64,{{ course.image }}" alt="{{ course.name }}"/>
                                        </t>
                                        <t t-else="">
                                            <div class="card-img-top elearning-course-image bg-light d-flex align-items-center justify-content-center">
                                                <i class="fa fa-graduation-cap fa-3x text-muted"></i>
                                            </div>
                                        </t>
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title"><t t-esc="course.name"/></h5>
                                            <p class="mb-2">
                                                <span t-attf-class="elearning-course-level level-{{ course.level }}">
                                                    <span t-field="course.level"/>
                                                </span>
                                            </p>
                                            <p class="card-text text-muted small">
                                                <i class="fa fa-user"></i> <t t-esc="course.instructor_id.name"/>
                                            </p>
                                            <p class="card-text text-muted small">
                                                <i class="fa fa-clock-o"></i> <t t-esc="course.duration_hours"/> hours
                                            </p>
                                            <p class="card-text flex-grow-1"><t t-raw="course.description"/></p>
                                            <div class="mt-auto">
                                                <t t-if="enrolled_course_ids and course.id in enrolled_course_ids">
                                                    <p class="h5 text-success mb-3"><i class="fa fa-check-circle"></i> Enrolled</p>
                                                </t>
                                                <t t-elif="course.price > 0">
                                                    <p class="h5 text-primary mb-3">$<t t-esc="'{:.2f}'.format(course.price)"/></p>
                                                </t>
                                                <t t-else="">
                                                    <p class="h5 text-success mb-3">Free</p>
                                                </t>
                                                
                                                <a t-attf-href="/elearning/course/{{ course.id }}" class="btn btn-primary btn-block">
                                                    <t t-if="enrolled_course_ids and course.id in enrolled_course_ids">
                                                        <i class="fa fa-play-circle"></i> Continue Learning
                                                    </t>
                                                    <t t-else="">
                                                        <i class="fa fa-arrow-right"></i> View Course
                                                    </t>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="alert alert-info">
                            <p>No courses available at the moment.</p>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <template id="course_detail_template" name="Course Detail">
        <t t-call="website.layout">
            <div id="elearning_course_detail" class="elearning-container">
                <div class="container">
                    <div class="row mb-5">
                        <div class="col-lg-8">
                            <h1 class="mb-3"><t t-esc="course.name"/></h1>
                            <div class="mb-3">
                                <span class="text-warning font-weight-bold">
                                    <t t-esc="'{:.1f}'.format(course.rating)"/> <i class="fa fa-star"></i>
                                </span>
                                <span class="text-muted ml-1 mr-3">(<t t-esc="course.rating_count"/> reviews)</span>
                                
                                <span t-attf-class="elearning-course-level level-{{ course.level }} mr-2">
                                    <span t-field="course.level"/>
                                </span>
                                <span class="text-muted"><i class="fa fa-user"></i> <t t-esc="course.instructor_id.name"/></span>
                            </div>
                            <p class="lead text-muted"><t t-raw="course.description"/></p>
                            
                            <hr/>
                            
                            <h3 class="mb-3">Course Content</h3>
                            <ul class="elearning-lesson-list">
                                <t t-foreach="course.lessons" t-as="lesson">
                                    <t t-set="is_completed" t-value="enrollment and lesson.id in enrollment.completed_lesson_ids.ids"/>
                                    <li t-attf-class="elearning-lesson-item {{ 'completed' if is_completed else '' }}" t-if="lesson.is_published">
                                        <div class="d-flex align-items-center w-100">
                                            <t t-if="enrollment or lesson.is_preview">
                                                <a t-attf-href="/elearning/lesson/{{ lesson.id }}" class="d-flex align-items-center flex-grow-1">
                                                    <span class="elearning-lesson-icon">
                                                        <t t-if="is_completed">
                                                            <i class="fa fa-check-circle text-success"></i>
                                                        </t>
                                                        <t t-elif="lesson.lesson_type == 'video'">
                                                            <i class="fa fa-play-circle"></i>
                                                        </t>
                                                        <t t-elif="lesson.lesson_type == 'document'">
                                                            <i class="fa fa-file-text-o"></i>
                                                        </t>
                                                        <t t-elif="lesson.lesson_type == 'quiz'">
                                                            <i class="fa fa-question-circle"></i>
                                                        </t>
                                                        <t t-elif="lesson.lesson_type == 'assignment'">
                                                            <i class="fa fa-pencil-square-o"></i>
                                                        </t>
                                                        <t t-else="">
                                                            <i class="fa fa-circle-o"></i>
                                                        </t>
                                                    </span>
                                                    
                                                    <span t-att-class="'text-muted' if is_completed else ''">
                                                        <t t-esc="lesson.name"/>
                                                    </span>
                                                    
                                                    <t t-if="lesson.is_preview and not enrollment">
                                                        <span class="badge badge-info ml-2">Preview</span>
                                                    </t>
                                                </a>
                                            </t>
                                            <t t-else="">
                                                <div class="d-flex align-items-center text-muted flex-grow-1" title="Enroll to access">
                                                    <span class="elearning-lesson-icon">
                                                        <i class="fa fa-lock"></i>
                                                    </span>
                                                    <t t-esc="lesson.name"/>
                                                </div>
                                            </t>
                                            
                                            <span class="text-muted small ml-3 whitespace-nowrap">
                                                <i class="fa fa-clock-o mr-1"></i><t t-esc="lesson.duration_minutes"/> min
                                            </span>
                                        </div>
                                    </li>
                                </t>
                            </ul>
                            
                            <hr class="mt-5"/>
                            <h3 class="mb-4">Reviews</h3>
                            
                            <div class="mb-5">
                                <t t-if="reviews">
                                    <t t-foreach="reviews" t-as="review">
                                        <div class="media mb-4 border-bottom pb-3">
                                            <div class="media-body">
                                                <h5 class="mt-0">
                                                    <t t-esc="review.user_id.name"/>
                                                    <small class="text-muted ml-2">
                                                        <t t-foreach="range(int(review.rating))" t-as="i">
                                                            <i class="fa fa-star text-warning"></i>
                                                        </t>
                                                        <t t-foreach="range(5 - int(review.rating))" t-as="i">
                                                            <i class="fa fa-star-o text-warning"></i>
                                                        </t>
                                                    </small>
                                                </h5>
                                                <p><t t-esc="review.comment"/></p>
                                                <small class="text-muted"><t t-esc="review.create_date"/></small>
                                            </div>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <p class="text-muted">No reviews yet. Be the first to review!</p>
                                </t>
                            </div>

                            <t t-if="enrollment and not user_review">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title">Write a Review</h5>
                                        <form method="POST" action="/elearning/course/review/submit">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="course_id" t-att-value="course.id"/>
                                            
                                            <div class="form-group">
                                                <label>Rating</label>
                                                <select name="rating" class="form-control" required="required">
                                                    <option value="5">5 Stars</option>
                                                    <option value="4">4 Stars</option>
                                                    <option value="3">3 Stars</option>
                                                    <option value="2">2 Stars</option>
                                                    <option value="1">1 Star</option>
                                                </select>
                                            </div>
                                            
                                            <div class="form-group">
                                                <label>Comment</label>
                                                <textarea name="comment" class="form-control" rows="3" placeholder="Share your experience..."></textarea>
                                            </div>
                                            
                                            <button type="submit" class="btn btn-primary">Submit Review</button>
                                        </form>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <div class="col-lg-4">
                            <div class="card sticky-top" style="top: 20px;">
                                <div class="card-body">
                                    <t t-if="enrollment">
                                        <h5 class="card-title mb-3">Your Progress</h5>
                                        <div class="elearning-progress mb-3">
                                            <div class="progress mb-2">
                                                <div class="progress-bar bg-success" role="progressbar" 
                                                     t-attf-style="width: {{ enrollment.progress }}%;" 
                                                     t-attf-aria-valuenow="{{ enrollment.progress }}" 
                                                     aria-valuemin="0" aria-valuemax="100">
                                                    <t t-esc="'{:.0f}'.format(enrollment.progress)"/>%
                                                </div>
                                            </div>
                                            <p class="mb-0"><strong>Status:</strong> 
                                                <span t-attf-class="elearning-status status-{{ enrollment.status }}">
                                                    <span t-field="enrollment.status"/>
                                                </span>
                                            </p>
                                        </div>
                                        <t t-if="enrollment.status == 'completed'">
                                            <div class="text-center mt-4 mb-3 p-3 bg-light rounded border">
                                                <div class="mb-3">
                                                    <i class="fa fa-trophy fa-4x text-warning"></i>
                                                </div>
                                                <h5 class="text-success font-weight-bold">Congratulations!</h5>
                                                <p class="text-muted small">You have successfully completed this course.</p>
                                                <a t-attf-href="/elearning/certificate/download/{{ enrollment.id }}" class="btn btn-success btn-block shadow-sm">
                                                    <i class="fa fa-download mr-1"></i> Download Certificate
                                                </a>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <a href="#" class="btn btn-primary btn-block mt-3">Continue Learning</a>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <h5 class="card-title mb-3">Ready to learn?</h5>
                                        <p class="text-muted"><strong>Course Price:</strong></p>
                                        <h3 class="text-primary mb-3">
                                            <t t-if="course.price > 0">
                                                $<t t-esc="'{:.2f}'.format(course.price)"/>
                                            </t>
                                            <t t-else="">
                                                Free
                                            </t>
                                        </h3>
                                        <form method="POST" t-attf-action="/elearning/enroll/{{ course.id }}" class="mb-2">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-success btn-block btn-lg">
                                                <i class="fa fa-sign-in"></i> Enroll Now
                                            </button>
                                        </form>
                                        <p class="text-center text-muted small">
                                            <t t-esc="course.student_count"/> students enrolled
                                        </p>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="lesson_template" name="Lesson View">
        <t t-call="website.layout">
            <div id="elearning_lesson" class="elearning-container">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card">
                                <div class="card-body">
                                    <nav aria-label="breadcrumb" class="mb-3">
                                        <ol class="breadcrumb">
                                            <li class="breadcrumb-item">
                                                <a t-attf-href="/elearning/course/{{ lesson.course_id.id }}">
                                                    <t t-esc="lesson.course_id.name"/>
                                                </a>
                                            </li>
                                            <li class="breadcrumb-item active"><t t-esc="lesson.name"/></li>
                                        </ol>
                                    </nav>
                                    
                                    <h1 class="mb-3"><t t-esc="lesson.name"/></h1>
                                    <p class="text-muted mb-3">
                                        <i class="fa fa-clock-o"></i> <t t-esc="lesson.duration_minutes"/> minutes | 
                                        <span class="badge badge-info"><t t-esc="lesson.lesson_type"/></span>
                                    </p>
                                    
                                    <!-- Video Content -->
                                    <t t-if="lesson.lesson_type == 'video' and lesson.video_embed_url">
                                        <div class="mb-4 position-relative" style="padding-bottom: 56.25%; height: 0; overflow: hidden;">
                                            <iframe t-attf-src="{{ lesson.video_embed_url }}" 
                                                    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;" 
                                                    frameborder="0" allowfullscreen=""></iframe>
                                        </div>
                                    </t>

                                    <!-- Document Content -->
                                    <t t-if="lesson.lesson_type == 'document' and lesson.document_file">
                                        <div class="alert alert-info mb-4">
                                            <div class="row align-items-center">
                                                <div class="col-auto">
                                                    <i class="fa fa-file-text-o fa-3x"></i>
                                                </div>
                                                <div class="col">
                                                    <h5 class="mb-1"><t t-esc="lesson.document_filename"/></h5>
                                                    <a t-attf-href="/web/content/elearning.lesson/{{ lesson.id }}/document_file/{{ lesson.document_filename }}?download=true" class="btn btn-primary btn-sm">
                                                        <i class="fa fa-download"></i> Download
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </t>

                                    <!-- Assignment Content -->
                                    <t t-if="lesson.lesson_type == 'assignment'">
                                        <div class="mb-4">
                                            <div class="alert alert-secondary">
                                                <h4 class="alert-heading"><i class="fa fa-pencil-square-o"></i> Assignment</h4>
                                                <div class="mb-3">
                                                    <t t-raw="lesson.assignment_instructions"/>
                                                </div>
                                                
                                                <t t-if="submission">
                                                    <hr/>
                                                    <h5>Your Submission</h5>
                                                    <p>
                                                        <strong>Status:</strong> 
                                                        <span t-attf-class="badge badge-{{ 'success' if submission.state == 'graded' else 'warning' }}">
                                                            <t t-esc="submission.state.capitalize()"/>
                                                        </span>
                                                        <br/>
                                                        <strong>Submitted:</strong> <span t-field="submission.submitted_date"/>
                                                    </p>
                                                    
                                                    <t t-if="submission.state == 'graded'">
                                                        <div class="alert alert-success">
                                                            <strong>Grade:</strong> <t t-esc="submission.grade"/>%
                                                            <t t-if="submission.instructor_feedback">
                                                                <br/>
                                                                <strong>Feedback:</strong>
                                                                <div class="mt-2">
                                                                    <t t-raw="submission.instructor_feedback"/>
                                                                </div>
                                                            </t>
                                                        </div>
                                                    </t>
                                                </t>
                                            </div>
                                            
                                            <t t-if="not submission or submission.state != 'graded'">
                                                <div class="card">
                                                    <div class="card-body">
                                                        <h5 class="card-title">Submit Assignment</h5>
                                                        <form method="POST" t-attf-action="/elearning/lesson/{{ lesson.id }}/assignment/submit" enctype="multipart/form-data">
                                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                            <div class="form-group">
                                                                <label for="submission_file">Upload File</label>
                                                                <input type="file" class="form-control-file" name="submission_file" required="required"/>
                                                            </div>
                                                            <div class="form-group">
                                                                <label for="submission_text">Notes (Optional)</label>
                                                                <textarea class="form-control" name="submission_text" rows="3"></textarea>
                                                            </div>
                                                            <button type="submit" class="btn btn-primary">
                                                                <i class="fa fa-upload"></i> Submit Assignment
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </t>

                                    <!-- Quiz Content -->
                                    <t t-if="lesson.lesson_type == 'quiz' and enrollment">
                                        <div class="mb-4">
                                            <div class="alert alert-warning">
                                                <h4 class="alert-heading"><i class="fa fa-question-circle"></i> Quiz</h4>
                                                <p>Please answer the following questions to complete this lesson.</p>
                                                <t t-if="quiz_results">
                                                    <hr/>
                                                    <p class="mb-0">
                                                        <strong>Score: <t t-esc="quiz_results['score']"/>%</strong>
                                                        <t t-if="quiz_results['passed']">
                                                            <span class="badge badge-success">Passed</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge badge-danger">Failed</span>
                                                            - Required: <t t-esc="lesson.quiz_passing_score"/>%
                                                        </t>
                                                    </p>
                                                </t>
                                            </div>
                                            
                                            <form method="POST" t-attf-action="/elearning/lesson/{{ lesson.id }}/quiz/submit">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <div class="quiz-container">
                                                    <t t-foreach="lesson.question_ids" t-as="question">
                                                        <div class="card mb-3">
                                                            <div class="card-header">
                                                                <strong>Question <t t-esc="question.sequence"/></strong>
                                                            </div>
                                                            <div class="card-body">
                                                                <p class="card-text"><t t-esc="question.question"/></p>
                                                                
                                                                <t t-if="question.question_type == 'multiple_choice'">
                                                                    <t t-foreach="question.option_ids" t-as="option">
                                                                        <div class="form-check">
                                                                            <input class="form-check-input" type="radio" 
                                                                                   t-attf-name="question_{{question.id}}" 
                                                                                   t-attf-id="q{{question.id}}_opt{{option.id}}" 
                                                                                   t-att-value="option.id"
                                                                                   t-att-checked="quiz_results and str(quiz_results['user_answers'].get(str(question.id))) == str(option.id)"
                                                                                   t-att-disabled="quiz_results and quiz_results['passed']"/>
                                                                            <label class="form-check-label" t-attf-for="q{{question.id}}_opt{{option.id}}">
                                                                                <t t-esc="option.content"/>
                                                                                <t t-if="quiz_results">
                                                                                    <t t-if="option.is_correct">
                                                                                        <span class="badge badge-success ml-2">Correct Answer</span>
                                                                                    </t>
                                                                                    <t t-elif="str(quiz_results['user_answers'].get(str(question.id))) == str(option.id) and not option.is_correct">
                                                                                        <span class="badge badge-danger ml-2">Your Answer</span>
                                                                                    </t>
                                                                                </t>
                                                                            </label>
                                                                        </div>
                                                                    </t>
                                                                </t>
                                                                <t t-if="question.question_type == 'text'">
                                                                    <input type="text" class="form-control" 
                                                                           t-attf-name="question_{{question.id}}" 
                                                                           t-att-value="quiz_results and quiz_results['user_answers'].get(str(question.id)) or ''"
                                                                           t-att-disabled="quiz_results and quiz_results['passed']"
                                                                           placeholder="Enter your answer"/>
                                                                    <t t-if="quiz_results and not quiz_results['passed']">
                                                                        <small class="text-muted mt-2 d-block">Correct Answer: <t t-esc="question.correct_answer_text"/></small>
                                                                    </t>
                                                                </t>
                                                            </div>
                                                        </div>
                                                    </t>
                                                    
                                                    <t t-if="not quiz_results or not quiz_results['passed']">
                                                        <button type="submit" class="btn btn-primary">Submit Quiz</button>
                                                    </t>
                                                </div>
                                            </form>
                                        </div>
                                    </t>
                                    
                                    <div class="lesson-content">
                                        <t t-raw="lesson.content"/>
                                    </div>
                                    
                                    <hr/>
                                    
                                    <div class="row mt-4">
                                        <div class="col-12">
                                            <t t-if="enrollment">
                                                <t t-if="lesson.id in enrollment.completed_lesson_ids.ids">
                                                    <div class="alert alert-success">
                                                        <i class="fa fa-check-circle"></i> Lesson Completed
                                                    </div>
                                                </t>
                                                <t t-elif="lesson.lesson_type != 'quiz'">
                                                    <form method="POST" t-attf-action="/elearning/lesson/{{ lesson.id }}/complete" class="d-inline">
                                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                        <button type="submit" class="btn btn-success">
                                                            <i class="fa fa-check"></i> Mark as Complete
                                                        </button>
                                                    </form>
                                                </t>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="card mb-3 sticky-top" style="top: 20px;">
                                <div class="card-body">
                                    <h5 class="card-title">Course Progress</h5>
                                    <t t-if="enrollment">
                                        <div class="progress mb-2">
                                            <div class="progress-bar bg-info" role="progressbar" 
                                                 t-attf-style="width: {{ enrollment.progress }}%;" 
                                                 t-attf-aria-valuenow="{{ enrollment.progress }}" 
                                                 aria-valuemin="0" aria-valuemax="100">
                                                <t t-esc="'{:.0f}'.format(enrollment.progress)"/>%
                                            </div>
                                        </div>
                                        <p class="small text-muted">
                                            <t t-esc="len(enrollment.completed_lesson_ids.filtered(lambda l: l.is_published))"/> of <t t-esc="len(lesson.course_id.lessons.filtered(lambda l: l.is_published))"/> lessons completed
                                        </p>
                                    </t>
                                    <t t-else="">
                                        <div class="alert alert-warning mb-0">
                                            <small>You need to enroll in this course to track progress</small>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="mb-0">Course Lessons</h6>
                                </div>
                                <ul class="list-group list-group-flush">
                                    <t t-foreach="lesson.course_id.lessons" t-as="l">
                                        <li t-attf-class="list-group-item {'active' if l.id == lesson.id else ''}">
                                            <t t-if="enrollment or l.is_preview">
                                                <a t-attf-href="/elearning/lesson/{{ l.id }}" 
                                                   t-attf-class="{'text-white' if l.id == lesson.id else ''}">
                                                    <t t-esc="l.name"/>
                                                    <t t-if="l.is_preview and not enrollment">
                                                        <span class="badge badge-light ml-1" style="font-size: 0.7em;">Preview</span>
                                                    </t>
                                                </a>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted">
                                                    <i class="fa fa-lock"></i> <t t-esc="l.name"/>
                                                </span>
                                            </t>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="certificate_template" name="Certificate">
        <t t-call="website.layout">
            <div id="elearning_certificate" class="elearning-container">
                <div class="container">
                    <div class="text-center mb-5">
                        <h1>Certificate of Completion</h1>
                    </div>
                    
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="elearning-certificate">
                                <div class="mb-5">
                                    <i class="fa fa-certificate fa-5x mb-3"></i>
                                </div>
                                
                                <h2 class="mb-4"><t t-esc="certificate.student_id.name"/></h2>
                                
                                <p class="lead mb-4">has successfully completed</p>
                                
                                <h1 class="mb-4"><t t-esc="certificate.course_id.name"/></h1>
                                
                                <div class="row mt-5 pt-5">
                                    <div class="col-md-6">
                                        <p><strong>Certificate No:</strong></p>
                                        <p><t t-esc="certificate.name"/></p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Issue Date:</strong></p>
                                        <p><t t-esc="certificate.issue_date.strftime('%B %d, %Y')"/></p>
                                    </div>
                                </div>
                                
                                <div class="row mt-3">
                                    <div class="col-md-6">
                                        <p><strong>Grade:</strong></p>
                                        <p><t t-esc="'{:.0f}'.format(certificate.grade)"/>%</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Status:</strong></p>
                                        <p><t t-if="certificate.verify_certificate()">✓ Valid</t><t t-else="">✗ Invalid</t></p>
                                    </div>
                                </div>
                                
                                <div class="certificate-hash">
                                    <p><strong>Certificate Hash:</strong></p>
                                    <p><t t-esc="certificate.certificate_hash"/></p>
                                </div>
                            </div>
                            
                            <div class="text-center mt-5">
                                <button onclick="window.print()" class="btn btn-secondary mr-2">
                                    <i class="fa fa-print"></i> Print Certificate
                                </button>
                                <a href="/elearning/my-certificates" class="btn btn-primary">
                                    <i class="fa fa-arrow-left"></i> Back to Certificates
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="my_certificates_template" name="My Certificates">
        <t t-call="website.layout">
            <div id="elearning_my_certificates" class="elearning-container">
                <div class="container">
                    <h1 class="mb-5">My Certificates</h1>
                    
                    <t t-if="certificates">
                        <div class="row">
                            <t t-foreach="certificates" t-as="cert">
                                <div class="col-lg-4 col-md-6 mb-4">
                                    <div class="card elearning-course-card h-100">
                                        <div class="card-body text-center">
                                            <i class="fa fa-certificate fa-4x text-warning mb-3"></i>
                                            <h5 class="card-title"><t t-esc="cert.course_id.name"/></h5>
                                            <p class="text-muted small">
                                                <i class="fa fa-calendar"></i> <t t-esc="cert.issue_date.strftime('%B %d, %Y')"/>
                                            </p>
                                            <p class="h6 text-success">Grade: <t t-esc="'{:.0f}'.format(cert.grade)"/>%</p>
                                            <a t-attf-href="/elearning/certificate/{{ cert.id }}" class="btn btn-primary btn-sm">
                                                View Certificate
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="alert alert-info">
                            <p>You haven't earned any certificates yet. <a href="/elearning/">Explore courses</a></p>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>
