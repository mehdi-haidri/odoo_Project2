<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Submission Form View -->
        <record id="view_elearning_submission_form" model="ir.ui.view">
            <field name="name">elearning.submission.form</field>
            <field name="model">elearning.submission</field>
            <field name="arch" type="xml">
                <form string="Submission">
                    <header>
                        <button name="action_grade_submission" string="Mark as Graded" type="object" class="oe_highlight" invisible="state == 'graded'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="student_id" readonly="1"/>
                                <field name="lesson_id" readonly="1"/>
                                <field name="submitted_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="grade"/>
                                <field name="submission_file" filename="submission_filename" readonly="1"/>
                                <field name="submission_filename" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Student Notes">
                                <field name="submission_text" readonly="1"/>
                            </page>
                            <page string="Instructor Feedback">
                                <field name="instructor_feedback"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Submission Tree View -->
        <record id="view_elearning_submission_tree" model="ir.ui.view">
            <field name="name">elearning.submission.tree</field>
            <field name="model">elearning.submission</field>
            <field name="arch" type="xml">
                <tree string="Submissions">
                    <field name="student_id"/>
                    <field name="lesson_id"/>
                    <field name="submitted_date"/>
                    <field name="state"/>
                    <field name="grade"/>
                </tree>
            </field>
        </record>

        <!-- Submission Action -->
        <record id="action_elearning_submission" model="ir.actions.act_window">
            <field name="name">Submissions</field>
            <field name="res_model">elearning.submission</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_elearning_submission"
                  name="Submissions"
                  parent="odoo_Project2.menu_elearning"
                  action="action_elearning_submission"
                  sequence="40"/>
    </data>
</odoo>
